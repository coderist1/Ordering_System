# Django
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL) — optional for local dev if using SQLite default
# DATABASE_URL=postgresql://myuser:strongpassword@localhost:5432/mydb

# CORS / frontend links
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── Brevo email (activation + password reset) ──
# Local dev: use console backend to print emails in the terminal (no real send)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production / real sends via Brevo SMTP:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-login@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
DEFAULT_FROM_EMAIL=Ordering System <your-verified-sender@gmail.com>

# Optional fallback if SMTP is blocked (Railway, some hosts)
BREVO_API_KEY=your-brevo-api-key

# Optional production security toggles
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
